# ============================================================
# FinLife Frontend — Environment Variables (Contoh)
# Salin file ini menjadi .env dan sesuaikan nilainya.
# ============================================================

# URL base API backend FinLife
# - Android Emulator  : http://10.0.2.2:3000/api
# - iOS Simulator     : http://localhost:3000/api
# - Device Fisik      : http://<IP_PC_LOKAL>:3000/api   contoh: http://192.168.1.5:3000/api
# - Production        : https://api.finlife.app/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Timeout request HTTP dalam milidetik
EXPO_PUBLIC_API_TIMEOUT=10000

# Nama aplikasi
EXPO_PUBLIC_APP_NAME=FinLife

